rules_version = '2';
// Reglas de seguridad: las revisa el servidor de Google en cada lectura y escritura.
// Cada cuenta tiene funciones (permisos): "admin" es el coordinador y puede todo;
// los demás solo lo de su función. Un miembro sin funciones ve el programa público
// y su propio informe. Nadie sin la función de coordinador ve las funciones de otros.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function memberPath(c) { return /databases/$(db)/documents/congregaciones/$(c)/miembros/$(me()); }
    function member(c) { return get(memberPath(c)).data; }
    function isMember(c) { return signedIn() && exists(memberPath(c)); }
    function isActive(c) { return isMember(c) && member(c).estado == 'activo'; }
    function isAdmin(c) { return isActive(c) && member(c).admin == true; }
    function can(c, p) { return isActive(c) && (member(c).admin == true || p in member(c).get('permisos', [])); }
    function myProfile(c) { return member(c).get('perfil', null); }
    // Todas las funciones son de ancianos: cualquiera de ellas da anuncios y directorio
    function isElder(c) { return can(c, 'ancianos') || can(c, 'programa') || can(c, 'secretario'); }
    function cong(c) { return get(/databases/$(db)/documents/congregaciones/$(c)).data; }
    function only(keys) { return request.resource.data.keys().hasOnly(keys); }
    function validPerms(d) { return !('permisos' in d) || (d.permisos is list && d.permisos.hasOnly(['programa', 'secretario', 'ancianos', 'cuentas', 'territorios', 'capitan'])); }

    // Qué congregación usa cada cuenta (solo la propia persona)
    match /usuarios/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid && only(['cong']);
    }

    // Código de la congregación -> id. Se puede consultar un código, no listarlos.
    match /codigos/{codigo} {
      allow get: if signedIn();
      allow create: if signedIn() && only(['cong'])
        && (isAdmin(request.resource.data.cong)
          || get(/databases/$(db)/documents/congregaciones/$(request.resource.data.cong)).data.creador == me());
      allow delete: if isAdmin(resource.data.cong);
    }

    match /congregaciones/{c} {
      allow get: if isActive(c) || (signedIn() && resource.data.creador == me());
      allow create: if signedIn() && request.resource.data.creador == me()
        && only(['nombre', 'codigo', 'creador', 'modo']);
      allow update: if isAdmin(c) && request.resource.data.creador == resource.data.creador
        && only(['nombre', 'codigo', 'creador', 'modo'])
        && (!('modo' in request.resource.data) || request.resource.data.modo in ['todos', 'encargados']);

      match /miembros/{uid} {
        // La persona ve su propia ficha; el coordinador ve todas.
        allow get: if (signedIn() && me() == uid) || isAdmin(c);
        allow list: if isAdmin(c);
        // Registrarse: queda "pendiente", sin funciones, y debe dar el código correcto.
        // Quien creó la congregación entra directo como coordinador.
        allow create: if signedIn() && me() == uid
          && only(['nombre', 'email', 'estado', 'admin', 'permisos', 'perfil', 'codigo', 'creado'])
          && request.resource.data.perfil == null
          && request.resource.data.get('permisos', []).size() == 0
          && get(/databases/$(db)/documents/codigos/$(request.resource.data.codigo)).data.cong == c
          && ((request.resource.data.estado == 'pendiente' && request.resource.data.admin == false)
            || (request.resource.data.estado == 'activo' && request.resource.data.admin == true
              && get(/databases/$(db)/documents/congregaciones/$(c)).data.creador == me()));
        // Solo el coordinador aprueba, une al perfil o da funciones.
        allow update: if isAdmin(c) && validPerms(request.resource.data);
        allow delete: if isAdmin(c);
      }

      // Datos del programa: perfiles (con edad y notas), familias, semanas y ajustes.
      // Los demás ancianos (secretario, función Anciano) también los leen: informes y directorio.
      match /perfiles/{id} {
        allow read: if isElder(c);
        allow write: if can(c, 'programa');
      }
      // Directorio: teléfono, dirección y contacto de emergencia de cada perfil. Solo ancianos (cualquier función).
      match /contactos/{id} {
        allow read, delete: if isElder(c);
        allow create, update: if isElder(c)
          && only(['tel', 'dir', 'emergencia', 'emergenciaTel'])
          && request.resource.data.get('tel', '') is string && request.resource.data.get('tel', '').size() <= 60
          && request.resource.data.get('dir', '') is string && request.resource.data.get('dir', '').size() <= 300
          && request.resource.data.get('emergencia', '') is string && request.resource.data.get('emergencia', '').size() <= 150
          && request.resource.data.get('emergenciaTel', '') is string && request.resource.data.get('emergenciaTel', '').size() <= 60;
      }
      // Cuentas de la congregación: movimientos (entradas, salidas, transferencias) y saldo inicial.
      // Solo quien tiene la función "Cuentas" y el coordinador.
      match /cuentas/{id} {
        allow read, delete: if can(c, 'cuentas');
        allow create, update: if can(c, 'cuentas')
          && only(['fecha', 'tipo', 'categoria', 'descripcion', 'monto', 'fondo', 'por', 'creado'])
          && request.resource.data.fecha is string && request.resource.data.fecha.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.tipo in ['entrada', 'salida', 'transferencia']
          && request.resource.data.fondo in ['caja', 'banco']
          && request.resource.data.monto is number && request.resource.data.monto > 0 && request.resource.data.monto < 100000000
          && request.resource.data.categoria is string && request.resource.data.categoria.size() <= 40
          && request.resource.data.descripcion is string && request.resource.data.descripcion.size() <= 300
          && request.resource.data.por == me();
      }
      match /cuentasConfig/{doc} {
        allow read, write: if can(c, 'cuentas');
      }
      // Territorios: los ve cualquier miembro activo (el mapa no tiene datos personales);
      // los cambia quien tiene la función "Territorios". coords = JSON de [[lat, lng], …].
      // El capitán al que se le asignó uno puede registrar en él (avance, calles, no predicar,
      // completarlo); no puede cambiar sus datos ni pasárselo a otro.
      function validTerritory(d) {
        return d.keys().hasOnly(['numero', 'nombre', 'tarjeta', 'notas', 'coords', 'calles', 'estado', 'asignadoA', 'capitan', 'desde', 'historial', 'veces', 'trabajadas', 'avance', 'noPredicar'])
          && d.numero is string && d.numero.size() > 0 && d.numero.size() <= 20
          && d.nombre is string && d.nombre.size() <= 100
          && d.get('tarjeta', '') is string && d.get('tarjeta', '').size() <= 20
          && d.notas is string && d.notas.size() <= 1000
          && d.coords is string && d.coords.size() <= 30000
          && d.get('calles', '') is string && d.get('calles', '').size() <= 30000
          && d.estado in ['disponible', 'asignado', 'terminado']
          && d.asignadoA is string && d.asignadoA.size() <= 100
          && d.get('capitan', '') is string && d.get('capitan', '').size() <= 128
          && (d.desde == null || (d.desde is string && d.desde.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
          && d.historial is list && d.historial.size() <= 50
          && d.get('veces', 0) is int && d.get('veces', 0) >= 0
          && d.get('trabajadas', '') is string && d.get('trabajadas', '').size() <= 60000
          && d.get('avance', '') is string && d.get('avance', '').size() <= 2000
          && d.get('noPredicar', '') is string && d.get('noPredicar', '').size() <= 30000;
      }
      function myTerritory(c, t) { return can(c, 'capitan') && t.get('capitan', '') == me(); }
      match /territorios/{id} {
        allow read: if isActive(c);
        allow delete: if can(c, 'territorios');
        allow create: if can(c, 'territorios') && validTerritory(request.resource.data);
        allow update: if validTerritory(request.resource.data)
          && (can(c, 'territorios')
            || (myTerritory(c, resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'asignadoA', 'capitan', 'desde', 'historial', 'veces', 'trabajadas', 'avance', 'noPredicar'])
              && request.resource.data.get('capitan', '') in ['', me()]
              && (request.resource.data.get('capitan', '') == me() || request.resource.data.estado == 'disponible')));
      }
      // Salidas registradas en los territorios. Las ven y corrigen el siervo de territorios y los capitanes
      // (solo agregan en los suyos).
      match /trabajos/{id} {
        function validWork(d) {
          return d.keys().hasOnly(['territorio', 'numero', 'fecha', 'completo', 'calles', 'avance', 'notas', 'por', 'porNombre', 'capitan', 'creado'])
            && d.territorio is string && d.numero is string && d.numero.size() <= 20
            && d.fecha is string && d.fecha.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && d.completo is bool
            && d.calles is string && d.calles.size() <= 30000
            && d.avance is string && d.avance.size() <= 2000
            && d.notas is string && d.notas.size() <= 1000
            && d.porNombre is string && d.porNombre.size() <= 100
            && d.capitan is string && d.capitan.size() <= 100;
        }
        allow read: if can(c, 'territorios') || can(c, 'capitan');
        allow create: if validWork(request.resource.data) && request.resource.data.por == me()
          && (can(c, 'territorios')
            || myTerritory(c, get(/databases/$(db)/documents/congregaciones/$(c)/territorios/$(request.resource.data.territorio)).data));
        allow update: if can(c, 'territorios') && validWork(request.resource.data) && request.resource.data.por == resource.data.por;
        allow delete: if can(c, 'territorios');
      }
      // Lista de capitanes (nombre y cuenta) que publica el coordinador para poder asignarles territorios.
      match /capitanes/{doc} {
        allow read: if isActive(c);
        allow write: if isAdmin(c);
      }
      // Anuncios: los leen todos los miembros activos; los publican los ancianos.
      match /anuncios/{id} {
        allow read: if isActive(c);
        allow delete: if isElder(c);
        allow create, update: if isElder(c)
          && only(['titulo', 'texto', 'fijado', 'vence', 'autor', 'autorNombre', 'fecha', 'editado'])
          && request.resource.data.titulo is string && request.resource.data.titulo.size() > 0 && request.resource.data.titulo.size() <= 150
          && request.resource.data.texto is string && request.resource.data.texto.size() <= 5000
          && request.resource.data.fijado is bool
          && (request.resource.data.vence == null || (request.resource.data.vence is string && request.resource.data.vence.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
          && request.resource.data.autor is string;
      }
      // Grupos de servicio del campo: los ven los ancianos (cualquier función); los arma el secretario.
      match /grupos/{id} {
        allow read: if isElder(c);
        allow delete: if can(c, 'secretario');
        allow create, update: if can(c, 'secretario')
          && only(['nombre', 'superintendente', 'auxiliar', 'miembros'])
          && request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() <= 60
          && (request.resource.data.superintendente == null || request.resource.data.superintendente is string)
          && (request.resource.data.auxiliar == null || request.resource.data.auxiliar is string)
          && request.resource.data.miembros is list && request.resource.data.miembros.size() <= 300;
      }
      match /familias/{id} {
        allow read, write: if can(c, 'programa');
      }
      match /semanas/{id} {
        allow read, write: if can(c, 'programa');
      }
      match /config/{doc} {
        allow read, write: if can(c, 'programa');
      }

      // Copia de los datos de la versión 1.2 (antes de separarlos). Solo el coordinador.
      match /privado/{doc} {
        allow read, write: if isAdmin(c);
      }

      // Programa de las semanas, ya con nombres: lo ve cualquier miembro activo.
      match /publico/{doc} {
        allow read: if isActive(c);
        allow write: if can(c, 'programa');
      }

      // Informe mensual: id = perfil_AAAA-MM. Cada quien el suyo (si la congregación
      // deja que los publicadores lo envíen); el secretario los ve y captura todos.
      match /informes/{id} {
        function validReport() {
          let d = request.resource.data;
          return only(['perfil', 'nombre', 'mes', 'grupo', 'participo', 'horas', 'cursos', 'notas', 'enviado', 'por'])
            && (!('grupo' in d) || d.grupo in ['pub', 'aux', 'reg'])
            && id == d.perfil + '_' + d.mes && d.mes.matches('[0-9]{4}-[0-9]{2}')
            && d.por == me()
            && d.participo is bool
            && (d.horas == null || (d.horas is number && d.horas >= 0 && d.horas <= 744))
            && d.cursos is int && d.cursos >= 0 && d.cursos <= 99
            && d.notas is string && d.notas.size() <= 1000;
        }
        function own() { return isActive(c) && myProfile(c) != null && id.matches(myProfile(c) + '_[0-9]{4}-[0-9]{2}'); }
        allow get: if can(c, 'secretario') || own();
        allow list: if can(c, 'secretario') || (isActive(c) && resource.data.perfil == myProfile(c));
        allow create, update: if validReport()
          && (can(c, 'secretario') || (own() && cong(c).get('modo', 'todos') == 'todos'));
        allow delete: if can(c, 'secretario');
      }
    }
  }
}
