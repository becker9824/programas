rules_version = '2';
// Reglas de seguridad: las revisa el servidor de Google en cada lectura y escritura.
// Cada cuenta tiene funciones (permisos): "admin" es el coordinador y puede todo;
// los demás solo lo de su función. Un miembro sin funciones ve el programa público
// y su propio informe. Nadie sin la función de coordinador ve las funciones de otros.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function memberPath(c) { return /databases/$(db)/documents/congregaciones/$(c)/miembros/$(me()); }
    function member(c) { return get(memberPath(c)).data; }
    function isMember(c) { return signedIn() && exists(memberPath(c)); }
    function isActive(c) { return isMember(c) && member(c).estado == 'activo'; }
    function isAdmin(c) { return isActive(c) && member(c).admin == true; }
    function can(c, p) { return isActive(c) && (member(c).admin == true || p in member(c).get('permisos', [])); }
    function myProfile(c) { return member(c).get('perfil', null); }
    function cong(c) { return get(/databases/$(db)/documents/congregaciones/$(c)).data; }
    function only(keys) { return request.resource.data.keys().hasOnly(keys); }
    function validPerms(d) { return !('permisos' in d) || (d.permisos is list && d.permisos.hasOnly(['programa', 'secretario'])); }

    // Qué congregación usa cada cuenta (solo la propia persona)
    match /usuarios/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid && only(['cong']);
    }

    // Código de la congregación -> id. Se puede consultar un código, no listarlos.
    match /codigos/{codigo} {
      allow get: if signedIn();
      allow create: if signedIn() && only(['cong'])
        && (isAdmin(request.resource.data.cong)
          || get(/databases/$(db)/documents/congregaciones/$(request.resource.data.cong)).data.creador == me());
      allow delete: if isAdmin(resource.data.cong);
    }

    match /congregaciones/{c} {
      allow get: if isActive(c) || (signedIn() && resource.data.creador == me());
      allow create: if signedIn() && request.resource.data.creador == me()
        && only(['nombre', 'codigo', 'creador', 'modo']);
      allow update: if isAdmin(c) && request.resource.data.creador == resource.data.creador
        && only(['nombre', 'codigo', 'creador', 'modo'])
        && (!('modo' in request.resource.data) || request.resource.data.modo in ['todos', 'encargados']);

      match /miembros/{uid} {
        // La persona ve su propia ficha; el coordinador ve todas.
        allow get: if (signedIn() && me() == uid) || isAdmin(c);
        allow list: if isAdmin(c);
        // Registrarse: queda "pendiente", sin funciones, y debe dar el código correcto.
        // Quien creó la congregación entra directo como coordinador.
        allow create: if signedIn() && me() == uid
          && only(['nombre', 'email', 'estado', 'admin', 'permisos', 'perfil', 'codigo', 'creado'])
          && request.resource.data.perfil == null
          && request.resource.data.get('permisos', []).size() == 0
          && get(/databases/$(db)/documents/codigos/$(request.resource.data.codigo)).data.cong == c
          && ((request.resource.data.estado == 'pendiente' && request.resource.data.admin == false)
            || (request.resource.data.estado == 'activo' && request.resource.data.admin == true
              && get(/databases/$(db)/documents/congregaciones/$(c)).data.creador == me()));
        // Solo el coordinador aprueba, une al perfil o da funciones.
        allow update: if isAdmin(c) && validPerms(request.resource.data);
        allow delete: if isAdmin(c);
      }

      // Datos del programa: perfiles (con edad y notas), familias, semanas y ajustes.
      // El secretario también lee los perfiles para llevar los informes.
      match /perfiles/{id} {
        allow read: if can(c, 'programa') || can(c, 'secretario');
        allow write: if can(c, 'programa');
      }
      match /familias/{id} {
        allow read, write: if can(c, 'programa');
      }
      match /semanas/{id} {
        allow read, write: if can(c, 'programa');
      }
      match /config/{doc} {
        allow read, write: if can(c, 'programa');
      }

      // Copia de los datos de la versión 1.2 (antes de separarlos). Solo el coordinador.
      match /privado/{doc} {
        allow read, write: if isAdmin(c);
      }

      // Programa de las semanas, ya con nombres: lo ve cualquier miembro activo.
      match /publico/{doc} {
        allow read: if isActive(c);
        allow write: if can(c, 'programa');
      }

      // Informe mensual: id = perfil_AAAA-MM. Cada quien el suyo (si la congregación
      // deja que los publicadores lo envíen); el secretario los ve y captura todos.
      match /informes/{id} {
        function validReport() {
          let d = request.resource.data;
          return only(['perfil', 'nombre', 'mes', 'participo', 'horas', 'cursos', 'notas', 'enviado', 'por'])
            && id == d.perfil + '_' + d.mes && d.mes.matches('[0-9]{4}-[0-9]{2}')
            && d.por == me()
            && d.participo is bool
            && (d.horas == null || (d.horas is number && d.horas >= 0 && d.horas <= 744))
            && d.cursos is int && d.cursos >= 0 && d.cursos <= 99
            && d.notas is string && d.notas.size() <= 1000;
        }
        function own() { return isActive(c) && myProfile(c) != null && id.matches(myProfile(c) + '_[0-9]{4}-[0-9]{2}'); }
        allow get: if can(c, 'secretario') || own();
        allow list: if can(c, 'secretario') || (isActive(c) && resource.data.perfil == myProfile(c));
        allow create, update: if validReport()
          && (can(c, 'secretario') || (own() && cong(c).get('modo', 'todos') == 'todos'));
        allow delete: if can(c, 'secretario');
      }
    }
  }
}
