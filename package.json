{
  "name": "programas",
  "productName": "Programas",
  "version": "1.23.1",
  "description": "Programas y asignaciones de la reunión Vida y Ministerio Cristianos",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prueba": "electron . --prueba",
    "instalador": "electron-builder --win nsis",
    "publicar": "powershell -ExecutionPolicy Bypass -File publicar.ps1",
    "prueba-reglas": "firebase emulators:exec --only firestore --project demo-reglas \"node --test pruebas/reglas.test.mjs\"",
    "nube-local": "firebase emulators:start --only auth,firestore --project demo-programas"
  },
  "build": {
    "appId": "local.programas.reunion",
    "productName": "Programas",
    "files": [
      "main.js",
      "index.html",
      "firebase-config.js",
      "icon.png",
      "icon.svg",
      "vendor/**"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "becker9824",
      "repo": "programas"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Programas",
      "artifactName": "Programas-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.1",
    "jspdf": "^2.5.1",
    "leaflet": "^1.9.4",
    "qrcode-generator": "^1.4.4",
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
